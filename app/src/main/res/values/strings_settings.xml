    <!-- Help and FAQ (s59) -->
    <string name="settings_help_title">Help and FAQ</string>
    <string name="settings_contact_support">Contact support</string>
    <string name="settings_faq_expanded">Expanded</string>
    <string name="settings_faq_collapsed">Collapsed</string>
    <string name="settings_faq_wont_scan_q">Why will my code not scan?</string>
    <string name="settings_faq_wont_scan_a">Hold the phone 15 to 30 cm away, add light with the flash, and keep the code flat inside the frame. Damaged codes may need a second try.</string>
    <string name="settings_faq_offline_q">Can I scan without internet?</string>
    <string name="settings_faq_offline_a">Yes. Scanning and creating codes work offline. You only need a connection to open a link or look up a product.</string>
    <string name="settings_faq_colors_q">How do I change the code colors?</string>
    <string name="settings_faq_colors_a">After you create a code, tap Customize and pick colors in the Colors tab. Keep strong contrast so the code stays easy to scan.</string>
    <string name="settings_faq_history_q">Where is my history stored?</string>
    <string name="settings_faq_history_a">Only on your phone. Nothing is uploaded. You can delete one item or clear everything in Settings.</string>
    <string name="settings_faq_photo_q">How do I scan from a photo?</string>
    <string name="settings_faq_photo_a">On the Scan screen tap the gallery button and pick an image. The app reads any code in it. Photos never leave your phone.</string>
    <string name="settings_faq_auto_open_q">Why does a link not open by itself?</string>
    <string name="settings_faq_auto_open_a">For your safety, links open only when you tap them. You can turn on Open links automatically in Settings, but check the address first.</string>
    <string name="settings_faq_wifi_q">How do I join Wi-Fi from a code?</string>
    <string name="settings_faq_wifi_a">Scan the Wi-Fi code, then tap Connect. Android may ask for location permission before it joins a network. You can also copy the password.</string>
    <string name="settings_faq_types_q">Which codes can I scan?</string>
    <string name="settings_faq_types_a">QR codes and common barcodes such as EAN, UPC, Code 128, Code 39, Data Matrix, PDF417 and Aztec.</string>
    <string name="settings_faq_export_q">How do I export my history?</string>
    <string name="settings_faq_export_a">Open Settings, then Export history. Choose CSV, JSON or Text, then save the file or share it.</string>
    <string name="settings_faq_language_q">How do I change the language?</string>
    <string name="settings_faq_language_a">Open Settings, then Language, and pick one. The app switches right away.</string>

